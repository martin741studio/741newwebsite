[Unit]
StartLimitIntervalSec=300
StartLimitBurst=4
Description=741 persistent-profile Chrome (CDP on 9222 for Playwright; visible via VNC)
After=browser-fluxbox.service
Requires=browser-fluxbox.service

[Service]
Type=simple
Environment=DISPLAY=:1
ExecStartPre=/bin/sleep 1
ExecStart=/home/nightshift/.cache/ms-playwright/chromium-1243/chrome-linux-arm64/chrome --user-data-dir=/home/nightshift/browser-profile --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 --no-first-run --no-default-browser-check --no-sandbox --window-size=1400,870 --window-position=0,0 about:blank
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
