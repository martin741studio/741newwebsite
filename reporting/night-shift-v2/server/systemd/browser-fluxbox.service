[Unit]
StartLimitIntervalSec=300
StartLimitBurst=4
Description=741 window manager for virtual display
After=browser-xvfb.service
Requires=browser-xvfb.service

[Service]
Type=simple
Environment=DISPLAY=:1
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/fluxbox
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
