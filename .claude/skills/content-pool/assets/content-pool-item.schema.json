{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://741.studio/schemas/content-pool-item.schema.json",
  "title": "Content pool item",
  "description": "One ranked content item of the 741 content pool. An agent can drill from the item to its raw data through evidence[].file and evidence[].ref.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pillar",
    "audience",
    "page_tag",
    "item_type",
    "topic",
    "fit",
    "fit_reason",
    "demand",
    "competitor",
    "compliance",
    "conversion",
    "effort",
    "score",
    "priority",
    "status",
    "owner",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CP-(LOC|SVC|BRD|AUT)-[0-9]{3}$"
    },
    "pillar": {
      "enum": [
        "location",
        "service",
        "brand",
        "authority"
      ]
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Who the item serves: patient | trainee | both, or a persona slug (e.g. replayers) when the run targets persona pages. For non-health clients use patient = customer."
    },
    "page_tag": {
      "type": "string",
      "description": "homepage | service:<slug> | place:<slug> | authority-page | blog-faq | later | cut"
    },
    "section_hint": {
      "type": [
        "string",
        "null"
      ],
      "description": "Homepage items only. One of the CRO P0 rows: hero, beweis-leiste, fuer-mich, leistungen, erster-termin, ueber, bewertungen, faq, standort, abschluss-cta."
    },
    "item_type": {
      "enum": [
        "block",
        "faq",
        "keyword-target",
        "proof",
        "entity-schema",
        "link-target",
        "page",
        "cut-log"
      ]
    },
    "topic": {
      "type": "string",
      "description": "Short name of the content item."
    },
    "question": {
      "type": [
        "string",
        "null"
      ],
      "description": "The real question or search intent, in the searcher's words."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kw",
          "scope",
          "volume",
          "volume_source",
          "volume_date"
        ],
        "properties": {
          "kw": {
            "type": "string"
          },
          "volume": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Monthly searches. null = no data (not zero demand)."
          },
          "volume_source": {
            "type": "string"
          },
          "volume_date": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "enum": [
              "local",
              "national"
            ],
            "description": "local = keyword names a place. national = no place name; volume score x 0.6."
          }
        }
      }
    },
    "service_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Key of the client service this item serves (services[] in pool.json). null for general items."
    },
    "fit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "3 = exact client service. 2 = education or question around a real service. 1 = adjacent topic, needs client confirmation. 0 = not offered, cut."
    },
    "fit_reason": {
      "type": "string"
    },
    "adjacent": {
      "type": "boolean"
    },
    "client_confirmation": {
      "enum": [
        "not_needed",
        "open",
        "confirmed",
        "declined"
      ]
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_max",
        "autocomplete_hits",
        "paa_hits",
        "basis",
        "date"
      ],
      "properties": {
        "volume_max": {
          "type": [
            "integer",
            "null"
          ]
        },
        "volume_sum": {
          "type": [
            "integer",
            "null"
          ]
        },
        "autocomplete_hits": {
          "type": "integer",
          "minimum": 0
        },
        "autocomplete_samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paa_hits": {
          "type": "integer",
          "minimum": 0
        },
        "paa_samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "client_signal": {
          "type": [
            "string",
            "null"
          ],
          "description": "Own ranking, GSC or review language that shows demand."
        },
        "trend_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "volume",
            "autocomplete",
            "paa",
            "client",
            "expectation",
            "none"
          ],
          "description": "What the demand score rests on."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "gsc": {
          "type": [
            "object",
            "null"
          ],
          "description": "Client Search Console signal for the item. Computed from 03-demand/gsc-queries-90d.tsv.",
          "additionalProperties": false,
          "properties": {
            "queries": {
              "type": "integer"
            },
            "impressions": {
              "type": "integer"
            },
            "clicks": {
              "type": "integer"
            },
            "best_position": {
              "type": [
                "number",
                "null"
              ]
            },
            "top_query": {
              "type": "string"
            }
          }
        }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "denominator",
        "covering",
        "share",
        "table_stakes"
      ],
      "properties": {
        "set": {
          "type": "string",
          "description": "Tiers measured, for example local+niche."
        },
        "denominator": {
          "type": "integer"
        },
        "covering": {
          "type": "integer"
        },
        "share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "covering_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "table_stakes": {
          "type": "boolean",
          "description": "true when 50 % or more of the set has it. Visitors expect it."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "flag"
      ],
      "properties": {
        "mode": {
          "enum": [
            "hwg",
            "brao",
            "none"
          ]
        },
        "flag": {
          "enum": [
            "ok",
            "review",
            "block"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conversion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "effort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 = text only. 2 = needs client facts or images. 3 = needs new page, asset or third party."
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demand",
        "gap",
        "fit",
        "conversion",
        "effort",
        "total"
      ],
      "properties": {
        "demand": {
          "type": "number"
        },
        "gap": {
          "type": "number"
        },
        "fit": {
          "type": "number"
        },
        "conversion": {
          "type": "number"
        },
        "effort": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      }
    },
    "priority": {
      "enum": [
        "A",
        "B",
        "C",
        "cut"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "needs_client",
        "adjacent_review",
        "approved",
        "cut",
        "done"
      ]
    },
    "live_status": {
      "enum": [
        "present",
        "weak",
        "missing",
        "n/a"
      ],
      "description": "Existing-site mode only. n/a in new-site mode."
    },
    "live_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "needs_client": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Each entry is one [FEHLT] fact the client must give."
    },
    "decision_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why the item was cut or flagged."
    },
    "owner": {
      "enum": [
        "agent",
        "martin",
        "client"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "file",
          "ref",
          "date"
        ],
        "properties": {
          "type": {
            "enum": [
              "volume",
              "serp",
              "paa",
              "autocomplete",
              "ranked",
              "competitor-page",
              "sitemap",
              "client-data",
              "gbp",
              "trends",
              "manual"
            ]
          },
          "file": {
            "type": "string",
            "description": "Path relative to the run folder."
          },
          "ref": {
            "type": "string",
            "description": "Key, keyword, URL or JSON path inside the file."
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}