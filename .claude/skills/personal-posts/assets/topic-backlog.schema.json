{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "personal-posts topic backlog",
  "type": "object",
  "required": ["ideas"],
  "properties": {
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lane", "idea", "status", "added"],
        "properties": {
          "id": {"type": "integer"},
          "lane": {"enum": ["uncomfortable-truths", "human-behavior", "entrepreneurship", "freedom-culture", "tech-ai-marketing", "health-performance", "personal-stories", "client-result"]},
          "idea": {"type": "string"},
          "source": {"type": "string"},
          "status": {"enum": ["open", "used", "skipped"]},
          "added": {"type": "string", "format": "date"},
          "used_date": {"type": ["string", "null"], "format": "date"}
        }
      }
    }
  }
}
