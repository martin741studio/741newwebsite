gic":"deu","ietfLanguageTag":"ger","iso6392LanguageCode":"de","genericName":"German","genericNativeName":"Deutsch"}],"hashedId":"gjg3u0s4ul","mediaId":138157717,"mediaKey":"wistia-production_138157717","mediaType":"Video","name":"Testimonial 1","preloadPreference":null,"progress":1.0,"protected":false,"projectId":10096580,"seoDescription":"a ME Webinar - Testimonials video","showAbout":true,"status":2,"type":"Video","playableWithoutInstantHls":true,"stats":{"loadCount":12311,"playCount":172,"uniqueLoadCount":5654,"uniquePlayCount":169,"averageEngagement":0.465426},"trackingTransmitInterval":20,"liveStreamEventDetails":null,"integrations":{"active_campaign":true},"tagManager":true,"captions":[{"language":"ger","text":"Früher brauchte ich zehn Minuten, Dinge zu erklären. Heute gelingt mir das in zwei Minuten und jeder versteht mich gleich. Ich wusste, ich muss was ändern. Ich hab im Internet recherchiert, Bücher gelesen, aber das ist letztendlich einfach alles trocken.\n\nEs ist kein echtes Üben, man bekommt kein Feedback. In dem Moment konnte das nicht funktionieren. Das weiß ich heute. Es gab auf jeden Fall Missverständnisse.\n\nDadurch, dass ich einfach meine Message nicht klar rüberbringen konnte, gab es immer wieder Situationen, wo ich dachte, ich hätte klar kommuniziert und ein Mitarbeiter hat seine Aufgabe beispielsweise gar nicht so verstanden, wie ich sie meinte. Ich hab wieder gelernt, ich kann es dank deiner Hilfe. Ja, mein Selbstbewusstsein ist auf jeden Fall gewachsen. Ich würde dieses Seminar auf jeden Fall Geschäftsführern empfehlen, die es einfach nicht schafften, durch ihre Kommunikation Mitarbeitende zu motivieren, mitzureißen, diese Leitfigur zu sein, wo die Leute sagen, hey, diese Person hat's drauf, da ist mein Vertrauen richtig aufgehoben.\n\nIch bin überzeugt davon, dass ich jetzt einfach besser hier rausgeh, als ich reinkam. Wenn Du das auch möchtest, dann klick einfach auf den Link."}],"hls_enabled":true,"embed_options":{"opaqueControls":null,