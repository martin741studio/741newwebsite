:"German","native_name":"Deutsch","right_to_left":false,"alpha3Bibliographic":"ger","alpha3Terminologic":"deu","ietfLanguageTag":"ger","iso6392LanguageCode":"de","genericName":"German","genericNativeName":"Deutsch"}],"hashedId":"o9x6ztrtrv","mediaId":138158204,"mediaKey":"wistia-production_138158204","mediaType":"Video","name":"Testimonial 3","preloadPreference":null,"progress":1.0,"protected":false,"projectId":10096580,"seoDescription":"a ME Webinar - Testimonials video","showAbout":true,"status":2,"type":"Video","playableWithoutInstantHls":true,"stats":{"loadCount":12359,"playCount":141,"uniqueLoadCount":5710,"uniquePlayCount":138,"averageEngagement":0.46627999999999997},"trackingTransmitInterval":20,"liveStreamEventDetails":null,"integrations":{"active_campaign":true},"tagManager":true,"captions":[{"language":"ger","text":"Unsere Teammeetings gingen von zwei Stunden auf fünfundvierzig Minuten runter und wir sind produktiver geworden. Es gab weniger Konflikte, weil ich klarere Aussagen getroffen habe, die mein Gegenüber verstanden hat. Mein Selbstbewusstsein vor dem Seminar war bei minus eins in Gesprächen. Nach der ersten Übung haben wir Feedback bekommen.\n\nDas hat sich eingeprägt. Ich hab mir gemerkt, was ich ändern muss, hab's dann versucht, in 'ner zweiten Übung umzusetzen und war das Feedback natürlich auch schon etwas besser. Ich hätte nie gedacht, dass ich innerhalb von nur drei Tagen die ganzen Werkzeuge an die Hand bekomme, ein guter Redner zu werden. In den ersten sieben Tagen nach dem Seminar habe ich schon die Mitarbeitergespräche ganz anders geführt.\n\nIch hatte kürzere, klare Sätze, die Aufgabenstellungen waren klar und die Mitarbeiter haben mich einfach verstanden. Ich fühle mich jetzt im Vergleich zu vorher viel sicherer, weil ich weiß, was ich tun kann, wenn ich irgendwo sprechen muss, ruhig zu bleiben, deutlich zu reden, früher war ich schneller, viel zu schnell eigentlich und das kam dann auch gar nicht rüber. Ich würde dieses Seminar definitiv allen Geschäftsführern empfehlen, weil sie von den Abteilungsleitern diese Dinge fordern und verlangen, selber aber nicht in der Lage sind, es zu tun. Willst Du das auch?\n\nDann klick auf den Link."}],"hls_enabled":true,"embed_options":{"opaqueControls":null,"playerColor":"#000000","playerColorGradient":{"on":false,"colors":[["#000000",0],["#666666",1]]},"plugin":{"captions-v1":{"on":"true"}},"volumeControl":"true","fullscreenButton":"true","controlsVisibleOnLoad":"true","bpbTime":"false","vulcan":true,"contrastIcons":true,"newRoundedIcons":true,"shouldShowCaptionsSettings":true},"embedOptions":{"opaqueControls":null,"playerColor":"#000000","playerColorGradient":{"on":false,"colors":[["#000000",0],["#666666",1]]},"plugin":{"captions-v1":{"on":"true"}},"volumeControl":"true","fullscreenButton":"true","controlsVisibleOnLoad":"true","bpbTime":"false","vulcan":true,"contrastIcons":true,"newRoundedIcons":true,"shouldShowCaptionsSettings":true}},"options":{}}