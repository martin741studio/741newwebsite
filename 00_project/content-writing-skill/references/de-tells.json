 "constructions": [
  {
   "label": "nicht nur ..., sondern auch",
   "re": "\\bnicht nur\\b.{0,90}?\\b(sondern|auch)\\b"
  },
  {
   "label": "es geht nicht um X, sondern um Y",
   "re": "\\bgeht es (nicht|weniger) (nur )?um\\b.{0,90}?\\bsondern\\b|\\bes geht (nicht|weniger) (nur )?um\\b.{0,90}?\\bsondern\\b"
  },
  {
   "label": "mehr als nur",
   "re": "\\bmehr als nur\\b"
  },
  {
   "label": "Ob ... oder ..., wir",
   "re": "\\bob\\b.{0,70}\\boder\\b.{0,70},\\s*(wir|bei uns|unser|ich|bei mir)\\b"
  },
  {
   "label": "Zeitgeist-Einstieg",
   "re": "\\bin (der|einer) (heutigen|modernen|schnelllebigen|digitalen)\\b"
  },
  {
   "label": "Abschluss-Floskel am Satzanfang",
   "re": "(^|[.!?]\\s+)(zusammenfassend|abschließend|fazit|insgesamt lässt sich)\\b"
  },
  {
   "label": "Selbstbeantwortete Frage",
   "re": "(^|[.!?]\\s+)(das ergebnis|die lösung|der grund|das beste daran|der vorteil)\\?"
  },
  {
   "label": "Wir verstehen, dass ...",
   "re": "\\b(wir|ich) (verstehen|weiß|wissen|kenne|kennen),? (wie|dass)\\b.{0,60}\\b(belastend|schwer|herausfordernd|schwierig)\\b"
  },
  {
   "label": "Doch das ist noch nicht alles",
   "re": "\\bdoch das (ist|war) noch nicht alles\\b|\\bund das ist noch nicht alles\\b"
  },
  {
   "label": "Egal ob ... oder",
   "re": "\\begal ob\\b.{0,70}\\boder\\b"
  }
 ],
